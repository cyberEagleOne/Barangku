# ==============================================================================
# Barangku Backend Configuration
# ==============================================================================

# Server Port (for standalone backend runner `npm run server`)
PORT=5000

# JWT Authentication Secret
JWT_SECRET=barangku-secret-key-2026-tangerang
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# (Dikerjakan oleh rekan database - cukup isi salah satu opsi berikut)
# ------------------------------------------------------------------------------
# Opsi 1: Menggunakan Connection String (Rekomendasi)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barangku

# Opsi 2: Konfigurasi per parameter
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=barangku
# PGSSLMODE=require

# Catatan untuk rekan database:
# 1. Jalankan server/db/schema.sql untuk membuat tabel dan ekstensi PostGIS.
# 2. Jalankan server/db/seed.sql untuk mengisi data awal (koordinat Tangerang & akun demo).
# 3. Jika DATABASE_URL belum diatur, backend akan otomatis menggunakan in-memory fallback.
