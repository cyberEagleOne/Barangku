# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
.vite/
vite.config.*.timestamp-*

# Environment variables and secrets (never commit these)
.env
.env.*
!.env.example

# Logs
*.log
logs/
*-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches and test output
.cache/
.eslintcache
.parcel-cache/
coverage/
*.tsbuildinfo
.tmp-*

# Deployment tool folders
.vercel/
.netlify/

# OS junk
.DS_Store
Thumbs.db

# Editor settings
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Figma Make / platform state
/.figma/design-context/
/.plugins/
/.opencode-skills/

# Local-only agent files (remove a line if you want to share it)
.claude/
.claude-replay.*
CLAUDE.md

# Figma Make state (site.json stays tracked because vite.config.ts imports it) and extra lock file
/.figma/make/*
!/.figma/make/site.json
pnpm-lock.yaml
